# SLEIGH specification for the ARCompact instruction set (ARC600 and ARC700 cores), shared by the
# little-endian (ARCompact.slaspec) and big-endian (ARCompact_be.slaspec) languages.
#
# Originally written by Nicolas Iooss (Ghidra pull request #3006, Apache License 2.0); big-endian
# token layout after Jackson Donaldson's arcompact_be_ghidra (Apache License 2.0). Reorganised by
# Ghidra-Rare: the general operations (major opcodes 4 to 6) are generated by
# tools/gen_arcompact.py into ARCompact_ops.sinc; see CREDITS.md for the list of changes.
#
# Syntax follows GNU binutils 2.45 (objdump -m ARC600/ARC700): ldh/sth/.aw spellings, ".f" before
# the condition, objdump's preferred condition names (p, n, c, nc, v, nv) and "0" for a
# discarded destination.

define alignment=2;

define space ram type=ram_space size=4 default;
define space register type=register_space size=2;

# Auxiliary registers, addressed by register number (32-bit words; instructions lr and sr)
define space auxregs type=ram_space size=2 wordsize=4;

# 64 32-bit core registers:
# * r0...r25 = basecase core registers, r26 = gp, r27 = fp, r28 = sp
# * r29 = ilink1, r30 = ilink2, r31 = blink
# * r32...r59 = extension core registers (r57..r59 = mlo/mmid/mhi of the ARC600 multiplier)
# * r60 = lp_count, r61 = reserved, r62 = long immediate indicator, r63 = pcl
define register offset=0x00 size=4 [
    r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
    r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 gp fp sp ilink1 ilink2 blink
    r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
    r48 r49 r50 r51 r52 r53 r54 r55 r56 mlo mmid mhi lp_count r61 r62 pcl
];

# Bits of the STATUS32 register: Zero, Negative, Carry, Overflow
define register offset=0x120 size=1 [ Z N C V ];
# Sticky saturation flag of the extended-arithmetic instructions, and the llock/scond lock flag
define register offset=0x128 size=1 [ S LF ];

define register offset=0x130 size=1 [ is_in_loop ];
define register offset=0x134 size=4 [ contextreg ];

define context contextreg
  phase = (0,0)
  loopEnd = (1,1) noflow
  loopStart = (2,31) noflow   # LP_START / 2 of the loop that ends here (set by lp)
;

define pcodeop brk;
define pcodeop ext_condition;
define pcodeop sleep;
define pcodeop swi;
define pcodeop sync;
define pcodeop trap_s;
define pcodeop unimp_s;

macro push4(x) {
  local mysave:4 = x;
  sp = sp - 4;
  *:4 sp = mysave;
}
macro pop4(x) {
  x = *:4 sp;
  sp = sp + 4;
}

macro update_flags_zn(value) {
  Z = value == 0:4;
  N = value s< 0:4;
}

macro update_flags_sub_zncv(op1, op2, result) {
  Z = op1 == op2;
  N = result s< 0:4;
  C = op1 < op2;
  V = sborrow(op1, op2);
}

# 16-bit instructions (major opcode 0x0c - 0x1f)
define token instr16 (16)
  s_major_opcode = (11, 15)
  s_sub_opcode_b9b10 = (9, 10)
  s_rb = (8, 10)
  s_rb_ = (8, 10)
  s_sub_opcode_b7 = (7, 7)
  s_sub_opcode_b6b7b8 = (6, 8)
  s_middle_u6 = (5, 10)
  s_rc = (5, 7)
  s_rb__ = (8, 10)
  s_rh_low_0 = (5, 7)
  s_rh_low_1 = (5, 7)
  s_rh_low_2 = (5, 7)
  s_rh_low_3 = (5, 7)
  s_rh_low_4 = (5, 7)
  s_rh_low_5 = (5, 7)
  s_rh_low_6 = (5, 7)
  s_rh_low_7 = (5, 7)
  s_sub_opcode_b5b6b7 = (5, 7)
  s_sub_opcode_b3b4 = (3, 4)
  s_s11 = (0, 10) signed
  s_s9 = (0, 8) signed
  s_u8 = (0, 7)
  s_s7 = (0, 6) signed
  s_u7 = (0, 6)
  s_s6 = (0, 5) signed
  s_u5 = (0, 4)
  s_u3 = (0, 2)
  s_ra = (0, 2)
  s_rh_high = (0, 2)
;

# 32-bit instructions (major opcode 0x00 - 0x0b). Field names give the bit positions of the
# instruction word (bit 31 = most significant bit of the first halfword).
@if ENDIAN == "big"
define token instr32 (32)
  l_major      = (27,31)
  l_b_lo       = (24,26)
  l_b_lo_0     = (24,26)
  l_b_lo_1     = (24,26)
  l_b_lo_2     = (24,26)
  l_b_lo_3     = (24,26)
  l_b_lo_4     = (24,26)
  l_b_lo_5     = (24,26)
  l_b_lo_6     = (24,26)
  l_b_lo_7     = (24,26)
  l_fmt        = (22,23)
  l_sub6       = (16,21)
  l_sub3hi     = (19,21)
  l_bit16      = (16,16)
  l_bit17      = (17,17)
  l_s10lo      = (17,26)
  l_s9lo       = (18,26)
  l_s7lo       = (17,23)
  l_s8lo       = (16,23)
  l_s8hi       = (15,15) signed
  l_ldr_zz     = (17,18)
  l_ldr_x      = (16,16)
  l_F          = (15,15)
  l_b_hi       = (12,14)
  l_s10mid     = (6,15)
  l_s10mid_s   = (6,15) signed
  l_c          = (6,11)
  l_u6         = (6,11)
  l_u6_aux     = (6,11)
  l_ld_di      = (11,11)
  l_ld_aa      = (9,10)
  l_ld_zz      = (7,8)
  l_ld_x       = (6,6)
  l_a          = (0,5)
  l_s6hi       = (0,5) signed
  l_M          = (5,5)
  l_N          = (5,5)
  l_cond       = (0,4)
  l_R4         = (4,4)
  l_s4hi       = (0,3) signed
  l_brop       = (0,3)
  l_st_di      = (5,5)
  l_st_aa      = (3,4)
  l_st_zz      = (1,2)
  l_st_r       = (0,0)
;
@else
# Little-endian: the instruction is stored as two 16-bit halfwords, high halfword first, so the
# bits of the first halfword are bits 0-15 of the token.
define token instr32 (32)
  l_major      = (11,15)
  l_b_lo       = (8,10)
  l_b_lo_0     = (8,10)
  l_b_lo_1     = (8,10)
  l_b_lo_2     = (8,10)
  l_b_lo_3     = (8,10)
  l_b_lo_4     = (8,10)
  l_b_lo_5     = (8,10)
  l_b_lo_6     = (8,10)
  l_b_lo_7     = (8,10)
  l_fmt        = (6,7)
  l_sub6       = (0,5)
  l_sub3hi     = (3,5)
  l_bit16      = (0,0)
  l_bit17      = (1,1)
  l_s10lo      = (1,10)
  l_s9lo       = (2,10)
  l_s7lo       = (1,7)
  l_s8lo       = (0,7)
  l_s8hi       = (31,31) signed
  l_ldr_zz     = (1,2)
  l_ldr_x      = (0,0)
  l_F          = (31,31)
  l_b_hi       = (28,30)
  l_s10mid     = (22,31)
  l_s10mid_s   = (22,31) signed
  l_c          = (22,27)
  l_u6         = (22,27)
  l_u6_aux     = (22,27)
  l_ld_di      = (27,27)
  l_ld_aa      = (25,26)
  l_ld_zz      = (23,24)
  l_ld_x       = (22,22)
  l_a          = (16,21)
  l_s6hi       = (16,21) signed
  l_M          = (21,21)
  l_N          = (21,21)
  l_cond       = (16,20)
  l_R4         = (20,20)
  l_s4hi       = (16,19) signed
  l_brop       = (16,19)
  l_st_di      = (21,21)
  l_st_aa      = (19,20)
  l_st_zz      = (17,18)
  l_st_r       = (16,16)
;
@endif

# Long immediate: a 32-bit word stored as two halfwords, high halfword first (both byte orders)
define token limm_low_token (16) limm_low = (0, 15);
define token limm_high_token (16) limm_high = (0, 15);

attach variables [ s_ra s_rb s_rb_ s_rb__ s_rc ] [ r0 r1 r2 r3 r12 r13 r14 r15 ];

attach variables [ l_a l_c ] [
    r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
    r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 gp fp sp ilink1 ilink2 blink
    r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
    r48 r49 r50 r51 r52 r53 r54 r55 r56 mlo mmid mhi lp_count r61 r62 pcl
];

# Auxiliary register names for lr/sr with a u6 operand (the names GNU objdump prints)
attach names [ l_u6_aux ] [
    "status" "semaphore" "lp_start" "lp_end" "identity" "debug" "pc" "adcr"
    "apcr" "acr" "status32" "status32_l1" "status32_l2" "0xd" "clk_enable" "bpu_flush"
    "ivic" "che_mode" "mulhi" "lockline" "dmc_code_ram" "tag_addr_mask" "tag_data_mask" "line_length_mask"
    "aux_ldst_ram" "unlockline" "ic_ram_address" "ic_tag" "ic_wp" "ic_data" "ic_ptag" "0x1f"
    "sram_seq" "count0" "control0" "limit0" "pcport" "int_vector_base" "aux_vbfdw_mode" "aux_vbfdw_bm0"
    "aux_vbfdw_bm1" "aux_vbfdw_accu" "aux_vbfdw_ofst" "aux_vbfdw_intstat" "aux_xmac0_24" "aux_xmac1_24" "aux_xmac2_24" "aux_fbf_store_16"
    "0x30" "0x31" "0x32" "0x33" "0x34" "0x35" "0x36" "0x37"
    "0x38" "0x39" "0x3a" "0x3b" "0x3c" "0x3d" "0x3e" "0x3f"
];

# The 6-bit b field is split (bits 14..12 high, 26..24 low); the high part selects the table
# (https://github.com/NationalSecurityAgency/ghidra/issues/1191)
attach variables [ l_b_lo_0 s_rh_low_0 ] [ r0 r1 r2 r3 r4 r5 r6 r7 ];
attach variables [ l_b_lo_1 s_rh_low_1 ] [ r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ l_b_lo_2 s_rh_low_2 ] [ r16 r17 r18 r19 r20 r21 r22 r23 ];
attach variables [ l_b_lo_3 s_rh_low_3 ] [ r24 r25 gp fp sp ilink1 ilink2 blink ];
attach variables [ l_b_lo_4 s_rh_low_4 ] [ r32 r33 r34 r35 r36 r37 r38 r39 ];
attach variables [ l_b_lo_5 s_rh_low_5 ] [ r40 r41 r42 r43 r44 r45 r46 r47 ];
attach variables [ l_b_lo_6 s_rh_low_6 ] [ r48 r49 r50 r51 r52 r53 r54 r55 ];
attach variables [ l_b_lo_7 s_rh_low_7 ] [ r56 mlo mmid mhi lp_count r61 r62 pcl ];
s_rh: s_rh_low_0 is s_rh_high=0 & s_rh_low_0 { export s_rh_low_0; }
s_rh: s_rh_low_1 is s_rh_high=1 & s_rh_low_1 { export s_rh_low_1; }
s_rh: s_rh_low_2 is s_rh_high=2 & s_rh_low_2 { export s_rh_low_2; }
s_rh: s_rh_low_3 is s_rh_high=3 & s_rh_low_3 { export s_rh_low_3; }
s_rh: s_rh_low_4 is s_rh_high=4 & s_rh_low_4 { export s_rh_low_4; }
s_rh: s_rh_low_5 is s_rh_high=5 & s_rh_low_5 { export s_rh_low_5; }
s_rh: s_rh_low_6 is s_rh_high=6 & s_rh_low_6 { export s_rh_low_6; }
s_rh: s_rh_low_7 is s_rh_high=7 & s_rh_low_7 { export s_rh_low_7; }
l_rb: l_b_lo_0 is l_b_hi=0 & l_b_lo_0 { export l_b_lo_0; }
l_rb: l_b_lo_1 is l_b_hi=1 & l_b_lo_1 { export l_b_lo_1; }
l_rb: l_b_lo_2 is l_b_hi=2 & l_b_lo_2 { export l_b_lo_2; }
l_rb: l_b_lo_3 is l_b_hi=3 & l_b_lo_3 { export l_b_lo_3; }
l_rb: l_b_lo_4 is l_b_hi=4 & l_b_lo_4 { export l_b_lo_4; }
l_rb: l_b_lo_5 is l_b_hi=5 & l_b_lo_5 { export l_b_lo_5; }
l_rb: l_b_lo_6 is l_b_hi=6 & l_b_lo_6 { export l_b_lo_6; }
l_rb: l_b_lo_7 is l_b_hi=7 & l_b_lo_7 { export l_b_lo_7; }

limm: limm is limm_high ; limm_low [ limm = (limm_high << 16) + limm_low; ] { export *[const]:4 limm; }

# ---------------------------------------------------------------------------------------------
# Register operands. A register field of 62 means "long immediate follows", 63 reads PCL (the
# address of the current instruction, 32-bit aligned); as a destination, 62 discards the result.

l_b_src: limm is l_b_hi=7 & l_b_lo_7=6 ; limm { export *[const]:4 limm; }
l_b_src: "pcl" is l_b_hi=7 & l_b_lo_7=7 { local v:4 = inst_start; v = v & 0xfffffffc; export v; }
l_b_src: l_rb is l_rb { export l_rb; }

l_c_src: limm is l_c=62 ; limm { export *[const]:4 limm; }
l_c_src: "pcl" is l_c=63 { local v:4 = inst_start; v = v & 0xfffffffc; export v; }
l_c_src: l_c is l_c { export l_c; }

l_b_dst: l_rb is l_rb { export l_rb; }
l_b_dst: "0" is l_b_hi=7 & l_b_lo_7=6 { local tmp:4 = 0; export tmp; }

l_a_dst: l_a is l_a { export l_a; }
l_a_dst: "0" is l_a=62 { local tmp:4 = 0; export tmp; }

s_h_src: limm is s_rh_high=7 & s_rh_low_7=6 ; limm { export *[const]:4 limm; }
s_h_src: "pcl" is s_rh_high=7 & s_rh_low_7=7 { local v:4 = inst_start; v = v & 0xfffffffc; export v; }
s_h_src: s_rh is s_rh { export s_rh; }

s_h_dst: s_rh is s_rh { export s_rh; }
s_h_dst: "0" is s_rh_high=7 & s_rh_low_7=6 { local tmp:4 = 0; export tmp; }

# General operations (major 4..8): source 2 and destination by operand format
#   fmt 0: a,b,c    fmt 1: a,b,u6    fmt 2: b,b,s12    fmt 3: <cc> b,b,c / b,b,u6
op4_c_src: l_c_src is l_fmt=0 ... & l_c_src { export l_c_src; }
op4_c_src: l_u6 is l_fmt=1 & l_u6 { export *[const]:4 l_u6; }
op4_c_src: s12 is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { export *[const]:4 s12; }
op4_c_src: l_c_src is (l_fmt=3 & l_M=0) ... & l_c_src { export l_c_src; }
op4_c_src: l_u6 is l_fmt=3 & l_M=1 & l_u6 { export *[const]:4 l_u6; }

op4_b_src: l_b_src is l_b_src { export l_b_src; }

op4_a: l_a_dst is (l_fmt=0 | l_fmt=1) & l_a_dst { export l_a_dst; }
op4_a: l_b_dst is (l_fmt=2 | l_fmt=3) & l_b_dst { export l_b_dst; }

# Conditions (true when the instruction executes). ccd is the ".cc" suffix of general operations
# (empty for "al" and for the unconditional formats), ccn the suffix of b/bl/j/jl/lp.
cc: "" is l_cond=0 { local t:1 = 1; export t; }
cc: "eq" is l_cond=1 { export Z; }
cc: "ne" is l_cond=2 { local t:1 = !Z; export t; }
cc: "p" is l_cond=3 { local t:1 = !N; export t; }
cc: "n" is l_cond=4 { export N; }
cc: "c" is l_cond=5 { export C; }
cc: "nc" is l_cond=6 { local t:1 = !C; export t; }
cc: "v" is l_cond=7 { export V; }
cc: "nv" is l_cond=8 { local t:1 = !V; export t; }
cc: "gt" is l_cond=9 { local t:1 = !Z && (N == V); export t; }
cc: "ge" is l_cond=10 { local t:1 = N == V; export t; }
cc: "lt" is l_cond=11 { local t:1 = N != V; export t; }
cc: "le" is l_cond=12 { local t:1 = Z || (N != V); export t; }
cc: "hi" is l_cond=13 { local t:1 = !C && !Z; export t; }
cc: "ls" is l_cond=14 { local t:1 = C || Z; export t; }
cc: "pnz" is l_cond=15 { local t:1 = !N && !Z; export t; }
# Conditions 16-31 are defined by extensions; objdump names 21, 23 and 24 and prints nothing for
# the others, Ghidra prints "e<number>".
cc: "nj" is l_cond=21 { local t:1 = ext_condition(21:1); export t; }
cc: "nm" is l_cond=23 { local t:1 = ext_condition(23:1); export t; }
cc: "nt" is l_cond=24 { local t:1 = ext_condition(24:1); export t; }
cc: "e"^l_cond is l_R4=1 & l_cond { local t:1 = ext_condition(l_cond:1); export t; }

ccn: cc is l_fmt=3 & cc { export cc; }
ccbl: cc is cc { export cc; }
ccbl: ".nj" is l_cond=21 { local t:1 = ext_condition(21:1); export t; }
ccbl: ".nm" is l_cond=23 { local t:1 = ext_condition(23:1); export t; }
ccbl: ".nt" is l_cond=24 { local t:1 = ext_condition(24:1); export t; }
ccn: ".nj" is l_fmt=3 & l_cond=21 { local t:1 = ext_condition(21:1); export t; }
ccn: ".nm" is l_fmt=3 & l_cond=23 { local t:1 = ext_condition(23:1); export t; }
ccn: ".nt" is l_fmt=3 & l_cond=24 { local t:1 = ext_condition(24:1); export t; }
ccd: "" is l_fmt=3 & l_cond=0 { local t:1 = 1; export t; }
ccd: "."^cc is l_fmt=3 & cc { export cc; }

# Branch targets (relative to PCL)
l_target_s21: target is l_s10lo & l_s10mid_s [ target = (inst_start & ~3) + ((l_s10mid_s << 11) | (l_s10lo << 1)); ] { export *[ram]:4 target; }
l_target_s25: target is l_s10lo & l_s10mid & l_s4hi [ target = (inst_start & ~3) + ((l_s4hi << 21) | (l_s10mid << 11) | (l_s10lo << 1)); ] { export *[ram]:4 target; }
l_target_bl21: target is l_s9lo & l_s10mid_s [ target = (inst_start & ~3) + ((l_s10mid_s << 11) | (l_s9lo << 2)); ] { export *[ram]:4 target; }
l_target_bl25: target is l_s9lo & l_s10mid & l_s4hi [ target = (inst_start & ~3) + ((l_s4hi << 21) | (l_s10mid << 11) | (l_s9lo << 2)); ] { export *[ram]:4 target; }
l_target_s9: target is l_s7lo & l_s8hi [ target = (inst_start & ~3) + ((l_s8hi << 8) | (l_s7lo << 1)); ] { export *[ram]:4 target; }
s_target_s7shift1: target is s_s7 [ target = (inst_start & ~3) + (s_s7 << 1); ] { export *[ram]:4 target; }
s_target_s10shift1: target is s_s9 [ target = (inst_start & ~3) + (s_s9 << 1); ] { export *[ram]:4 target; }
s_target_s7cc: target is s_s6 [ target = (inst_start & ~3) + (s_s6 << 1); ] { export *[ram]:4 target; }
s_target_s13shift2: target is s_s11 [ target = (inst_start & ~3) + (s_s11 << 2); ] { export *[ram]:4 target; }
s_target_u8shift2: target is s_u8 [ target = (inst_start & ~3) + (s_u8 << 2); ] { export *[ram]:4 target; }

s_u5shift1: value is s_u5 [ value = s_u5 << 1; ] { export *[const]:4 value; }
s_u5shift2: value is s_u5 [ value = s_u5 << 2; ] { export *[const]:4 value; }
s_u8shift2: value is s_u8 [ value = s_u8 << 2; ] { export *[const]:4 value; }
s_s9shift1: value is s_s9 [ value = s_s9 << 1; ] { export *[const]:4 value; }
s_s9shift2: value is s_s9 [ value = s_s9 << 2; ] { export *[const]:4 value; }

l_s9: value is l_s8lo & l_s8hi [ value = (l_s8hi << 8) | l_s8lo; ] { export *[const]:4 value; }
# ",s9" in an address, omitted when 0 (as objdump does)
s9o: "" is l_s8lo=0 & l_s8hi=0 { local z:4 = 0; export z; }
s9o: ","^l_s9 is l_s9 { export l_s9; }

# Delay slot and cache-bypass suffixes
l_nd: "" is l_N=0 { }
l_nd: ".d" is l_N=1 { }

# ---------------------------------------------------------------------------------------------
# Zero-overhead loop: the instruction at LP_END (marked through the loopEnd context by "lp")
# first branches back to LP_START while LP_COUNT has not reached 0. The loop start is kept in the
# loopStart context as well, so the branch back is direct (the decompiler sees a loop).
lpstart: addr is loopStart [ addr = loopStart << 1; ] { export *[ram]:4 addr; }
:^instruction is phase=0 & instruction [ phase = 1; ] {
  build instruction;
}
:^instruction is phase=0 & loopEnd=1 & lpstart & instruction [ phase = 1; ] {
  if (is_in_loop == 0) goto <end_loop>;
  lp_count = lp_count - 1;
  if (lp_count == 0) goto <end_loop>;
  goto lpstart;
<end_loop>
  is_in_loop = 0;
  build instruction;
}

with : phase=1 {

# ---------------------------------------------------------------------------------------------
# Branch, 0x00. Bit 4 of the unconditional far form is reserved; it is ignored (as by objdump).
:b^cc^l_nd l_target_s21 is l_major=0x00 & l_bit16=0 & l_nd & l_N=0 & l_target_s21 & cc {
  if (cc) goto l_target_s21;
}
:b^cc^l_nd l_target_s21 is l_major=0x00 & l_bit16=0 & l_nd & l_N=1 & l_target_s21 & cc {
  local t:1 = cc;
  delayslot(1);
  if (t) goto l_target_s21;
}
:b^l_nd l_target_s21 is l_major=0x00 & l_bit16=0 & l_nd & l_N=0 & l_target_s21 & l_cond=0 {
  goto l_target_s21;
}
:b^l_nd l_target_s21 is l_major=0x00 & l_bit16=0 & l_nd & l_N=1 & l_target_s21 & l_cond=0 {
  delayslot(1);
  goto l_target_s21;
}
:b^l_nd l_target_s25 is l_major=0x00 & l_bit16=1 & l_nd & l_N=0 & l_target_s25 {
  goto l_target_s25;
}
:b^l_nd l_target_s25 is l_major=0x00 & l_bit16=1 & l_nd & l_N=1 & l_target_s25 {
  delayslot(1);
  goto l_target_s25;
}

# Branch and link, 0x01 bit 16 = 0. With a delay slot, blink is the address after the delay
# slot instruction, which is what inst_next means for an instruction with a delay slot.
:bl^ccbl^l_nd l_target_bl21 is l_major=0x01 & l_bit16=0 & l_bit17=0 & l_nd & l_N=0 & l_target_bl21 & ccbl {
  if (!ccbl) goto inst_next;
  blink = inst_next;
  call l_target_bl21;
}
:bl^ccbl^l_nd l_target_bl21 is l_major=0x01 & l_bit16=0 & l_bit17=0 & l_nd & l_N=1 & l_target_bl21 & ccbl {
  local t:1 = ccbl;
  delayslot(1);
  if (!t) goto <skip>;
  blink = inst_next;
  call l_target_bl21;
<skip>
}
:bl^l_nd l_target_bl21 is l_major=0x01 & l_bit16=0 & l_bit17=0 & l_nd & l_N=0 & l_target_bl21 & l_cond=0 {
  blink = inst_next;
  call l_target_bl21;
}
:bl^l_nd l_target_bl21 is l_major=0x01 & l_bit16=0 & l_bit17=0 & l_nd & l_N=1 & l_target_bl21 & l_cond=0 {
  blink = inst_next;
  delayslot(1);
  call l_target_bl21;
}
:bl^l_nd l_target_bl25 is l_major=0x01 & l_bit16=0 & l_bit17=1 & l_nd & l_N=0 & l_target_bl25 {
  blink = inst_next;
  call l_target_bl25;
}
:bl^l_nd l_target_bl25 is l_major=0x01 & l_bit16=0 & l_bit17=1 & l_nd & l_N=1 & l_target_bl25 {
  blink = inst_next;
  delayslot(1);
  call l_target_bl25;
}

# Branch on compare / bit test, 0x01 bit 16 = 1: register-register (bit 4 = 0) or
# register-u6 (bit 4 = 1). Opcodes 6..13 are reserved.
# (generated into ARCompact_ops.sinc)

# ---------------------------------------------------------------------------------------------
# Loads and stores

# data size and address-writeback suffixes (objdump order: <zz>.di.aa.x)
ld_zz: "" is l_ld_zz=0 { }
ld_zz: "b" is l_ld_zz=1 { }
ld_zz: "h" is l_ld_zz=2 { }
st_zz: "" is l_st_zz=0 { }
st_zz: "b" is l_st_zz=1 { }
st_zz: "h" is l_st_zz=2 { }
ldr_zz: "" is l_ldr_zz=0 { }
ldr_zz: "b" is l_ldr_zz=1 { }
ldr_zz: "h" is l_ldr_zz=2 { }
ld_di: "" is l_ld_di=0 { }
ld_di: ".di" is l_ld_di=1 { }
st_di: "" is l_st_di=0 { }
st_di: ".di" is l_st_di=1 { }
F_di: "" is l_F=0 { }
F_di: ".di" is l_F=1 { }
ld_x: "" is l_ld_x=0 { }
ld_x: ".x" is l_ld_x=1 { }
ldr_x: "" is l_ldr_x=0 { }
ldr_x: ".x" is l_ldr_x=1 { }
ld_aa: "" is l_ld_aa=0 { }
ld_aa: ".aw" is l_ld_aa=1 { }
ld_aa: ".ab" is l_ld_aa=2 { }
ld_aa: ".as" is l_ld_aa=3 { }
ld_aa: "" is l_ld_aa=0 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
ld_aa: "" is l_ld_aa=1 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
ld_aa: "" is l_ld_aa=2 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
ld_aa: "" is l_ld_aa=3 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
st_aa: "" is l_st_aa=0 { }
st_aa: ".aw" is l_st_aa=1 { }
st_aa: ".ab" is l_st_aa=2 { }
st_aa: ".as" is l_st_aa=3 { }
st_aa: "" is l_st_aa=0 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
st_aa: "" is l_st_aa=1 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
st_aa: "" is l_st_aa=2 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
st_aa: "" is l_st_aa=3 & l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
ldr_aa: "" is l_fmt=0 { }
ldr_aa: ".aw" is l_fmt=1 { }
ldr_aa: ".ab" is l_fmt=2 { }
ldr_aa: ".as" is l_fmt=3 { }

# Effective address and write-back for an address mode
#   aa 0: [b+off]   1 (.aw): [b+off], b = b+off   2 (.ab): [b], b = b+off   3 (.as): [b + off<<size]
ld_ea: l_b_src^s9o is (l_ld_aa=0 & s9o) ... & l_b_src { local ea:4 = l_b_src + s9o; export ea; }
ld_ea: l_rb^s9o is l_ld_aa=1 & l_rb & s9o { l_rb = l_rb + s9o; export l_rb; }
ld_ea: l_rb^s9o is l_ld_aa=2 & l_rb & s9o { local ea:4 = l_rb; l_rb = l_rb + s9o; export ea; }
ld_ea: limm^s9o is l_ld_aa=1 & l_b_hi=7 & l_b_lo_7=6 & s9o ; limm { local ea:4 = limm + s9o; export ea; }
ld_ea: limm^s9o is l_ld_aa=2 & l_b_hi=7 & l_b_lo_7=6 & s9o ; limm { export limm; }
ld_ea: l_b_src^s9o is (l_ld_aa=3 & l_ld_zz=2 & s9o) ... & l_b_src { local ea:4 = l_b_src + (s9o << 1); export ea; }
ld_ea: l_b_src^s9o is (l_ld_aa=3 & l_ld_zz=0 & s9o) ... & l_b_src { local ea:4 = l_b_src + (s9o << 2); export ea; }
ld_ea: l_b_src^s9o is (l_ld_aa=3 & l_ld_zz=1 & s9o) ... & l_b_src { local ea:4 = l_b_src + s9o; export ea; }

st_ea: l_b_src^s9o is (l_st_aa=0 & s9o) ... & l_b_src { local ea:4 = l_b_src + s9o; export ea; }
st_ea: l_rb^s9o is l_st_aa=1 & l_rb & s9o { l_rb = l_rb + s9o; export l_rb; }
st_ea: l_rb^s9o is l_st_aa=2 & l_rb & s9o { local ea:4 = l_rb; l_rb = l_rb + s9o; export ea; }
st_ea: limm^s9o is l_st_aa=1 & l_b_hi=7 & l_b_lo_7=6 & s9o ; limm { local ea:4 = limm + s9o; export ea; }
st_ea: limm^s9o is l_st_aa=2 & l_b_hi=7 & l_b_lo_7=6 & s9o ; limm { export limm; }
st_ea: l_b_src^s9o is (l_st_aa=3 & l_st_zz=2 & s9o) ... & l_b_src { local ea:4 = l_b_src + (s9o << 1); export ea; }
st_ea: l_b_src^s9o is (l_st_aa=3 & l_st_zz=0 & s9o) ... & l_b_src { local ea:4 = l_b_src + (s9o << 2); export ea; }
st_ea: l_b_src^s9o is (l_st_aa=3 & l_st_zz=1 & s9o) ... & l_b_src { local ea:4 = l_b_src + s9o; export ea; }

ldr_ea: l_b_src, l_c_src is (l_fmt=0) ... & l_b_src & l_c_src { local ea:4 = l_b_src + l_c_src; export ea; }
ldr_ea: l_rb, l_c_src is (l_fmt=1 & l_rb) ... & l_c_src { l_rb = l_rb + l_c_src; export l_rb; }
ldr_ea: l_rb, l_c_src is (l_fmt=2 & l_rb) ... & l_c_src { local ea:4 = l_rb; l_rb = l_rb + l_c_src; export ea; }
ldr_ea: l_b_src, l_c_src is (l_fmt=1 & l_b_hi=7 & l_b_lo_7=6) ... & l_b_src & l_c_src { local ea:4 = l_b_src + l_c_src; export ea; }
ldr_ea: l_b_src, l_c_src is (l_fmt=2 & l_b_hi=7 & l_b_lo_7=6) ... & l_b_src & l_c_src { export l_b_src; }
ldr_ea: l_b_src, l_c_src is (l_fmt=3 & l_ldr_zz=2) ... & l_b_src & l_c_src { local ea:4 = l_b_src + (l_c_src << 1); export ea; }
ldr_ea: l_b_src, l_c_src is (l_fmt=3 & l_ldr_zz=0) ... & l_b_src & l_c_src { local ea:4 = l_b_src + (l_c_src << 2); export ea; }
ldr_ea: l_b_src, l_c_src is (l_fmt=3 & l_ldr_zz=1) ... & l_b_src & l_c_src { local ea:4 = l_b_src + l_c_src; export ea; }

# Load, 0x02: ld<zz>.di.aa.x a,[b,s9]. zz=3 is reserved; .x on a 32-bit load and write-back to
# the long immediate are invalid. A destination of 62 (ARC700) is "prefetch" for a 32-bit load.
:ld^ld_zz^ld_di^ld_aa^ld_x l_a, [ld_ea] is (l_major=0x02 & l_ld_zz=0 & ld_zz & ld_di & ld_aa & ld_x & l_a) ... & ld_ea {
  l_a = *[ram]:4 ld_ea;
}
:ld^ld_zz^ld_di^ld_aa^ld_x "0", [ld_ea] is (l_major=0x02 & l_ld_zz=0 & ld_zz & ld_di & ld_aa & ld_x & l_a=62) ... & ld_ea {
  local tmp:4 = *[ram]:4 ld_ea;
}
:ld^ld_zz^ld_di^ld_aa^ld_x l_a, [ld_ea] is (l_major=0x02 & l_ld_zz=1 & l_ld_x=0 & ld_zz & ld_di & ld_aa & ld_x & l_a) ... & ld_ea {
  l_a = zext(*[ram]:1 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x "0", [ld_ea] is (l_major=0x02 & l_ld_zz=1 & l_ld_x=0 & ld_zz & ld_di & ld_aa & ld_x & l_a=62) ... & ld_ea {
  local tmp:4 = zext(*[ram]:1 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x l_a, [ld_ea] is (l_major=0x02 & l_ld_zz=1 & l_ld_x=1 & ld_zz & ld_di & ld_aa & ld_x & l_a) ... & ld_ea {
  l_a = sext(*[ram]:1 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x "0", [ld_ea] is (l_major=0x02 & l_ld_zz=1 & l_ld_x=1 & ld_zz & ld_di & ld_aa & ld_x & l_a=62) ... & ld_ea {
  local tmp:4 = sext(*[ram]:1 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x l_a, [ld_ea] is (l_major=0x02 & l_ld_zz=2 & l_ld_x=0 & ld_zz & ld_di & ld_aa & ld_x & l_a) ... & ld_ea {
  l_a = zext(*[ram]:2 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x "0", [ld_ea] is (l_major=0x02 & l_ld_zz=2 & l_ld_x=0 & ld_zz & ld_di & ld_aa & ld_x & l_a=62) ... & ld_ea {
  local tmp:4 = zext(*[ram]:2 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x l_a, [ld_ea] is (l_major=0x02 & l_ld_zz=2 & l_ld_x=1 & ld_zz & ld_di & ld_aa & ld_x & l_a) ... & ld_ea {
  l_a = sext(*[ram]:2 ld_ea);
}
:ld^ld_zz^ld_di^ld_aa^ld_x "0", [ld_ea] is (l_major=0x02 & l_ld_zz=2 & l_ld_x=1 & ld_zz & ld_di & ld_aa & ld_x & l_a=62) ... & ld_ea {
  local tmp:4 = sext(*[ram]:2 ld_ea);
}
:prefetch^ld_di^ld_aa [ld_ea] is (l_major=0x02 & l_ld_zz=0 & l_ld_x=0 & ld_di & ld_aa & l_a=62) ... & ld_ea {
  # a cache hint: no architectural effect beyond the address write-back of .aw/.ab
  local ea:4 = ld_ea;
}

# Store, 0x03: st<zz>.di.aa c,[b,s9]. With a long-immediate base the forms are st c,[limm] and
# st limm,[limm,s9] (as in objdump's table); other combinations are rejected.
st_ok: is l_b_hi!=7 { }
st_ok: is l_b_hi=7 & l_b_lo_7!=6 { }
st_ok: is l_b_hi=7 & l_b_lo_7=6 & l_c=62 { }
st_ok: is l_b_hi=7 & l_b_lo_7=6 & l_s8lo=0 & l_F=0 { }
st_ok: is l_b_hi=7 & l_b_lo_7=6 & l_c=62 & l_s8lo=0 & l_F=0 { }
:st^st_zz^st_di^st_aa l_c_src, [st_ea] is (l_major=0x03 & st_ok & l_st_zz!=3 & st_zz & st_di & st_aa & l_st_zz=0) ... & st_ea & l_c_src {
  *[ram]:4 st_ea = l_c_src;
}
:st^st_zz^st_di^st_aa l_c_src, [st_ea] is (l_major=0x03 & st_ok & st_zz & st_di & st_aa & l_st_zz=1) ... & st_ea & l_c_src {
  *[ram]:1 st_ea = l_c_src:1;
}
:st^st_zz^st_di^st_aa l_c_src, [st_ea] is (l_major=0x03 & st_ok & st_zz & st_di & st_aa & l_st_zz=2) ... & st_ea & l_c_src {
  *[ram]:2 st_ea = l_c_src:2;
}


# Load register-register, 0x04 sub-opcodes 0x30..0x37: ld<zz>.di.aa.x a,[b,c]
:ld^ldr_zz^F_di^ldr_aa^ldr_x l_a, [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=0 & ldr_zz & F_di & ldr_aa & ldr_x & l_a) ... & ldr_ea {
  l_a = *[ram]:4 ldr_ea;
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x "0", [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=0 & ldr_zz & F_di & ldr_aa & ldr_x & l_a=62) ... & ldr_ea {
  local tmp:4 = *[ram]:4 ldr_ea;
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x l_a, [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=1 & l_ldr_x=0 & ldr_zz & F_di & ldr_aa & ldr_x & l_a) ... & ldr_ea {
  l_a = zext(*[ram]:1 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x "0", [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=1 & l_ldr_x=0 & ldr_zz & F_di & ldr_aa & ldr_x & l_a=62) ... & ldr_ea {
  local tmp:4 = zext(*[ram]:1 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x l_a, [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=1 & l_ldr_x=1 & ldr_zz & F_di & ldr_aa & ldr_x & l_a) ... & ldr_ea {
  l_a = sext(*[ram]:1 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x "0", [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=1 & l_ldr_x=1 & ldr_zz & F_di & ldr_aa & ldr_x & l_a=62) ... & ldr_ea {
  local tmp:4 = sext(*[ram]:1 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x l_a, [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=2 & l_ldr_x=0 & ldr_zz & F_di & ldr_aa & ldr_x & l_a) ... & ldr_ea {
  l_a = zext(*[ram]:2 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x "0", [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=2 & l_ldr_x=0 & ldr_zz & F_di & ldr_aa & ldr_x & l_a=62) ... & ldr_ea {
  local tmp:4 = zext(*[ram]:2 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x l_a, [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=2 & l_ldr_x=1 & ldr_zz & F_di & ldr_aa & ldr_x & l_a) ... & ldr_ea {
  l_a = sext(*[ram]:2 ldr_ea);
}
:ld^ldr_zz^F_di^ldr_aa^ldr_x "0", [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=2 & l_ldr_x=1 & ldr_zz & F_di & ldr_aa & ldr_x & l_a=62) ... & ldr_ea {
  local tmp:4 = sext(*[ram]:2 ldr_ea);
}
:prefetch^F_di^ldr_aa [ldr_ea] is (l_major=0x04 & l_sub3hi=6 & l_ldr_zz=0 & l_ldr_x=0 & F_di & ldr_aa & l_a=62) ... & ldr_ea {
  local ea:4 = ldr_ea;
}

# ---------------------------------------------------------------------------------------------
# Jumps, 0x04 sub-opcodes 0x20..0x23: j/j.d/jl/jl.d [c] (j.f [ilink1/2] returns from interrupt)

jc: "["^l_c^"]" is l_c { export l_c; }
jc: "[pcl]" is l_c=63 { local v:4 = inst_start; v = v & 0xfffffffc; export v; }
jsrc: jc is (l_fmt=0 | (l_fmt=3 & l_M=0)) & jc { export jc; }
jsrc: l_u6 is (l_fmt=1 | (l_fmt=3 & l_M=1)) & l_u6 { export *[const]:4 l_u6; }
jsrc: s12 is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { export *[const]:4 s12; }
# with a delay slot the target cannot be a long immediate
jcd: "["^l_c^"]" is l_c & l_u6!=62 & l_u6!=63 { export l_c; }
jcd: "[pcl]" is l_c=63 { local v:4 = inst_start; v = v & 0xfffffffc; export v; }
jsrcd: jcd is (l_fmt=0 | (l_fmt=3 & l_M=0)) & jcd { export jcd; }
jsrcd: l_u6 is (l_fmt=1 | (l_fmt=3 & l_M=1)) & l_u6 { export *[const]:4 l_u6; }
jsrcd: s12 is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { export *[const]:4 s12; }

# STATUS32_L1/L2 (aux registers 0x0b and 0x0c) restore the flags on j.f [ilink1/ilink2]
macro restore_flags(st) {
  Z = (st & (1 << 11)) != 0;
  N = (st & (1 << 10)) != 0;
  C = (st & (1 << 9)) != 0;
  V = (st & (1 << 8)) != 0;
}

# j/jl in formats 0-2 are unconditional; format 3 carries a condition (c with M=0, u6 with M=1)
:j jsrc is (l_major=0x04 & l_sub6=0x20 & l_F=0 & l_fmt!=3) & jsrc {
  pcl = jsrc;
  goto [pcl];
}
:j^ccn jsrc is (l_major=0x04 & l_sub6=0x20 & l_F=0 & ccn) & jsrc {
  if (!ccn) goto inst_next;
  pcl = jsrc;
  goto [pcl];
}
:j "[blink]" is l_major=0x04 & l_sub6=0x20 & l_F=0 & l_fmt=0 & l_c=31 {
  pcl = blink;
  return [pcl];
}
:j^ccn "[blink]" is l_major=0x04 & l_sub6=0x20 & l_F=0 & l_M=0 & l_c=31 & ccn {
  if (!ccn) goto inst_next;
  pcl = blink;
  return [pcl];
}
:j.f "[ilink]" is l_major=0x04 & l_sub6=0x20 & l_F=1 & l_fmt=0 & l_c=29 {
  local st:4 = *[auxregs]:4 (0x0b:2);
  *[auxregs]:4 (0x0a:2) = st;
  restore_flags(st);
  pcl = ilink1;
  return [pcl];
}
:j.f "[r30]" is l_major=0x04 & l_sub6=0x20 & l_F=1 & l_fmt=0 & l_c=30 {
  local st:4 = *[auxregs]:4 (0x0c:2);
  *[auxregs]:4 (0x0a:2) = st;
  restore_flags(st);
  pcl = ilink2;
  return [pcl];
}
:j.f^ccn "[ilink]" is l_major=0x04 & l_sub6=0x20 & l_F=1 & l_M=0 & l_c=29 & ccn {
  if (!ccn) goto inst_next;
  local st:4 = *[auxregs]:4 (0x0b:2);
  *[auxregs]:4 (0x0a:2) = st;
  restore_flags(st);
  pcl = ilink1;
  return [pcl];
}
:j.f^ccn "[r30]" is l_major=0x04 & l_sub6=0x20 & l_F=1 & l_M=0 & l_c=30 & ccn {
  if (!ccn) goto inst_next;
  local st:4 = *[auxregs]:4 (0x0c:2);
  *[auxregs]:4 (0x0a:2) = st;
  restore_flags(st);
  pcl = ilink2;
  return [pcl];
}
:j.d jsrcd is (l_major=0x04 & l_sub6=0x21 & l_F=0 & l_fmt!=3) & jsrcd {
  local target:4 = jsrcd;
  delayslot(1);
  pcl = target;
  goto [pcl];
}
:j^ccn^".d" jsrcd is (l_major=0x04 & l_sub6=0x21 & l_F=0 & ccn) & jsrcd {
  local t:1 = ccn;
  local target:4 = jsrcd;
  delayslot(1);
  if (!t) goto inst_next;
  pcl = target;
  goto [pcl];
}
:j.d "[blink]" is l_major=0x04 & l_sub6=0x21 & l_F=0 & l_fmt=0 & l_c=31 {
  local target:4 = blink;
  delayslot(1);
  pcl = target;
  return [pcl];
}
:j^ccn^".d" "[blink]" is l_major=0x04 & l_sub6=0x21 & l_F=0 & l_M=0 & l_c=31 & ccn {
  local t:1 = ccn;
  local target:4 = blink;
  delayslot(1);
  if (!t) goto inst_next;
  pcl = target;
  return [pcl];
}
:jl jsrc is (l_major=0x04 & l_sub6=0x22 & l_F=0 & l_fmt!=3) & jsrc {
  blink = inst_next;
  pcl = jsrc;
  call [pcl];
}
:jl^ccn jsrc is (l_major=0x04 & l_sub6=0x22 & l_F=0 & ccn) & jsrc {
  if (!ccn) goto inst_next;
  blink = inst_next;
  pcl = jsrc;
  call [pcl];
}
:jl.d jsrcd is (l_major=0x04 & l_sub6=0x23 & l_F=0 & l_fmt!=3) & jsrcd {
  local target:4 = jsrcd;
  blink = inst_next;
  delayslot(1);
  pcl = target;
  call [pcl];
}
:jl^ccn^".d" jsrcd is (l_major=0x04 & l_sub6=0x23 & l_F=0 & ccn) & jsrcd {
