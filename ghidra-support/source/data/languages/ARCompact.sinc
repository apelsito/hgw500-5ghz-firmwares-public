}
:extb_s s_rb, s_rc is s_major_opcode=0x0f & s_u5=0x0f & s_rb & s_rc {
  s_rb = s_rc & 0xff;
}
:extw_s s_rb, s_rc is s_major_opcode=0x0f & s_u5=0x10 & s_rb & s_rc {
  s_rb = s_rc & 0xffff;
