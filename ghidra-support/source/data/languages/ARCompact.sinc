}
:jeq_s "[blink]" is s_major_opcode=0x0f & s_u5=0 & s_sub_opcode_b5b6b7=7 & s_rb=4 {
  if (!Z) goto <next>;
  pcl = blink;
  return [pcl];
<next>
}
:jne_s "[blink]" is s_major_opcode=0x0f & s_u5=0 & s_sub_opcode_b5b6b7=7 & s_rb=5 {
  if (Z) goto <next>;
  pcl = blink;
  return [pcl];
<next>
}
:j_s "[blink]" is s_major_opcode=0x0f & s_u5=0 & s_sub_opcode_b5b6b7=7 & s_rb=6 {
  pcl = blink;
  return [pcl];
}
:j_s.d "[blink]" is s_major_opcode=0x0f & s_u5=0 & s_sub_opcode_b5b6b7=7 & s_rb=7 {
  local target:4 = blink;
