}
# Jumps to a long immediate are direct
jlimm: limm is limm { export *[ram]:4 limm; }
:j jlimm is l_major=0x04 & l_sub6=0x20 & l_F=0 & l_fmt=0 & l_c=62 ; jlimm {
  goto jlimm;
}
:j^ccn jlimm is l_major=0x04 & l_sub6=0x20 & l_F=0 & l_M=0 & l_c=62 & ccn ; jlimm {
  if (ccn) goto jlimm;
}
:jl jlimm is l_major=0x04 & l_sub6=0x22 & l_F=0 & l_fmt=0 & l_c=62 ; jlimm {
