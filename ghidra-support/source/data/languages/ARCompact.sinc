<done>
}
:not_s s_rb, s_rc is s_major_opcode=0x0f & s_u5=0x12 & s_rb & s_rc {
  s_rb = ~s_rc;
}
:neg_s s_rb, s_rc is s_major_opcode=0x0f & s_u5=0x13 & s_rb & s_rc {
  s_rb = -s_rc;
}
:add1_s s_rb, s_rb_, s_rc is s_major_opcode=0x0f & s_u5=0x14 & s_rb & s_rb_ & s_rc {
