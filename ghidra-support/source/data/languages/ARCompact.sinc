:jl^ccn jlimm is l_major=0x04 & l_sub6=0x22 & l_F=0 & l_M=0 & l_c=62 & ccn ; jlimm {
  if (!ccn) goto inst_next;
  blink = inst_next;
  call jlimm;
}

# ---------------------------------------------------------------------------------------------
# Loop set-up, 0x04 sub-opcode 0x28: lp s13 (format 2), lp<cc> u7 (format 3), lp u7 (format 1,
# ARC600). LP_START (aux 0x02) is the next instruction, LP_END (aux 0x03) the target.
lp_end: target is l_fmt=2 & l_u6 & l_s6hi [ target = (inst_start & ~3) + ((l_s6hi << 7) | (l_u6 << 1)); ] { export *[ram]:4 target; }
lp_end: target is l_fmt=3 & l_M=1 & l_u6 [ target = (inst_start & ~3) + (l_u6 << 1); ] { export *[ram]:4 target; }
lp_end: target is l_fmt=1 & l_u6 [ target = (inst_start & ~3) + (l_u6 << 1); ] { export *[ram]:4 target; }

:lp^ccn lp_end is l_major=0x04 & l_sub6=0x28 & l_F=0 & l_fmt=3 & l_M=1 & ccn & lp_end
    [ loopEnd = 1; globalset(lp_end, loopEnd); loopStart = (inst_start + 4) >> 1; globalset(lp_end, loopStart); ] {
  is_in_loop = 0;
  if (!ccn) goto lp_end;
  *[auxregs]:4 (0x02:2) = inst_next;
  *[auxregs]:4 (0x03:2) = &lp_end;
  is_in_loop = 1;
}
:lp lp_end is l_major=0x04 & l_sub6=0x28 & l_F=0 & (l_fmt=2 | l_fmt=1) & lp_end
    [ loopEnd = 1; globalset(lp_end, loopEnd); loopStart = (inst_start + 4) >> 1; globalset(lp_end, loopStart); ] {
  *[auxregs]:4 (0x02:2) = inst_next;
  *[auxregs]:4 (0x03:2) = &lp_end;
  is_in_loop = 1;
}

# Flag, 0x04 sub-opcode 0x29: write STATUS32 (aux 0x0a) and the Z/N/C/V copies
:flag op4_c_src is (l_major=0x04 & l_sub6=0x29 & l_F=0 & l_fmt!=3) ... & op4_c_src {
  local v:4 = op4_c_src;
  *[auxregs]:4 (0x0a:2) = v;
  restore_flags(v);
}
:flag^ccd op4_c_src is (l_major=0x04 & l_sub6=0x29 & l_F=0 & l_fmt=3 & ccd) ... & op4_c_src {
  if (!ccd) goto <skip>;
  local v:4 = op4_c_src;
  *[auxregs]:4 (0x0a:2) = v;
  restore_flags(v);
<skip>
}

# Load/store auxiliary register, 0x04 sub-opcodes 0x2a/0x2b: lr b,[c] / sr b,[c]
aux: "["^l_c^"]" is l_fmt=0 & l_c { local a:2 = l_c:2; export *[auxregs]:4 a; }
aux: "["^limm^"]" is l_fmt=0 & l_c=62 ; limm { local a:2 = limm:2; export *[auxregs]:4 a; }
aux: "["^l_u6_aux^"]" is l_fmt=1 & l_u6_aux & l_u6 { export *[auxregs]:4 l_u6; }
aux: "["^s12^"]" is l_fmt=2 & l_u6 & l_s6hi [ s12 = (l_s6hi << 6) | l_u6; ] { local a:2 = s12; export *[auxregs]:4 a; }

:lr l_b_dst, aux is (l_major=0x04 & l_sub6=0x2a & l_F=0 & (l_fmt=0 | (l_fmt=1 & l_a=0) | l_fmt=2) & l_b_dst) ... & aux {
  l_b_dst = aux;
}
:sr l_b_src, aux is (l_major=0x04 & l_sub6=0x2b & l_F=0 & (l_fmt=0 | (l_fmt=1 & l_a=0) | l_fmt=2)) ... & l_b_src & aux {
  aux = l_b_src;
}

@include "ARCompact_ops.sinc"

