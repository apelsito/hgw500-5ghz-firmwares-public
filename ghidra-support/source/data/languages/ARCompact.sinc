  # transform away from the following jeq_s/jne_s
  s_rb = s_rb * zext(Z);
}
:nop_s is s_major_opcode=0x0f & s_u5=0 & s_sub_opcode_b5b6b7=7 & s_rb=0 { }
:unimp_s is s_major_opcode=0x0f & s_u5=0 & s_sub_opcode_b5b6b7=7 & s_rb=1 {
