<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/processor_spec.rxg -->

<processor_spec>
  <programcounter register="pcl"/>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="auxregs" first="0x0" last="0x1"/>
    <!-- auxiliary registers are addressed by number; LP_START (2) and LP_END (3) are not volatile -->
    <range space="auxregs" first="0x4" last="0xFFFF"/>
  </volatile>
  <default_memory_blocks>
    <!-- auxiliary registers (lr/sr), one 32-bit word per register number; a block is needed for
         the register names below to be applied -->
    <memory_block name="AUX_REGS" start_address="auxregs:0000" length="0x4000" initialized="false"/>
  </default_memory_blocks>
  <default_symbols>
    <symbol name="STATUS" address="auxregs:0000"/>
    <symbol name="SEMAPHORE" address="auxregs:0001"/>
    <symbol name="LP_START" address="auxregs:0002"/>
